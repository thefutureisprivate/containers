    ],
    "smoke": [
      "/bin/prometheus",
      "--version"
    ]
  },
  "blackbox-exporter": {
    "runtime": "scratch",
    "binaries": [
      "/bin/blackbox_exporter"
    ],
    "smoke": [
      "/bin/blackbox_exporter",
      "--version"
    ]
  },
  "postgres-exporter": {
    "runtime": "scratch",
    "binaries": [
      "/bin/postgres_exporter"
    ],
    "smoke": [
      "/bin/postgres_exporter",
      "--version"
    ]
  },
  "node-exporter": {
    "runtime": "scratch",
    "binaries": [
      "/bin/node_exporter"
    ],
    "smoke": [
      "/bin/node_exporter",
      "--version"
    ]
  },
  "alertmanager": {
    "runtime": "scratch",
    "binaries": [
      "/bin/alertmanager",
      "/bin/amtool"
