{
  "kanidm": {
    "runtime": "scratch",
    "binaries": [],
    "smoke": [
      "/sbin/kanidmd",
      "version"
    ]
  },
  "kanidm-radius": {
    "runtime": "upstream",
    "binaries": [],
    "smoke": [
      "/usr/sbin/radiusd",
      "-v"
    ]
  },
  "stalwart": {
    "runtime": "upstream",
    "binaries": [],
    "smoke": [
      "/usr/local/bin/stalwart",
      "--version"
    ]
  },
  "prometheus": {
    "runtime": "scratch",
    "binaries": [
      "/bin/prometheus",
