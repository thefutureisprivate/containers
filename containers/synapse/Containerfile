FROM registry-1.docker.io/library/alpine:3.24.0@sha256:a2d49ea686c2adfe3c992e47dc3b5e7fa6e6b5055609400dc2acaeb241c829f4
RUN apk add synapse ca-certificates
COPY requirements.txt /usr/share/obs-container/requirements.txt
RUN python3 -c 'from importlib.metadata import version; from pathlib import Path; assert "matrix-synapse=="+version("matrix-synapse") == Path("/usr/share/obs-container/requirements.txt").read_text().strip()'
COPY --chmod=0755 entrypoint.sh /usr/local/bin/synapse-start
RUN mkdir -p /data && chown 991:991 /data
ENV HOME=/data PYTHONMALLOC=malloc
WORKDIR /data
VOLUME ["/data"]
EXPOSE 8008
ENTRYPOINT ["/usr/local/bin/synapse-start"]
RUN find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod a-s '{}' +
COPY --chmod=0644 hardened-malloc.so /usr/local/lib/libhardened_malloc.so
COPY --chmod=0755 allocator-check /usr/local/bin/allocator-check
COPY --chmod=0644 hardened-malloc.LICENSE /usr/share/licenses/hardened_malloc/LICENSE
ENV LD_PRELOAD=/usr/local/lib/libhardened_malloc.so
USER 991:991
