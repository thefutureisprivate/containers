<services>
  <service name="download_url">
    <param name="protocol">https</param>
    <param name="host">github.com</param>
    <param name="path">kanidm/kanidm/archive/refs/tags/v1.11.2.tar.gz</param>
    <param name="filename">upstream.tar.gz</param>
  </service>
  <service name="cargo_vendor">
    <param name="src">upstream.tar.gz</param>
    <param name="update">false</param>
    <param name="respect-lockfile">true</param>
    <param name="compression">gz</param>
  </service>
  <service name="container_policy" mode="buildtime">
    <param name="name">kanidm-radius</param>
  </service>
</services>
