FROM registry-1.docker.io/library/alpine:3.24.0@sha256:a2d49ea686c2adfe3c992e47dc3b5e7fa6e6b5055609400dc2acaeb241c829f4 AS builder
# apk 3 uses a plain absolute path for an offline file repository.
RUN sed -i 's|^file:||' /etc/apkrepos_obs_dockersupport
RUN apk add nodejs npm nodejs-dev python3 build-base musl-dev linux-headers pkgconf bluez-dev eudev-dev
WORKDIR /app
COPY package.json package-lock.json ./
COPY *.tgz /source-packages/
# OBS downloads the integrity-pinned tarballs; npm installs and builds entirely offline.
# usb 2.x requests C++14, but its current node-addon-api dependency requires C++17.
RUN for package in /source-packages/*.tgz; do npm cache add "$package" --ignore-scripts; done \
    && npm ci --offline --ignore-scripts --legacy-peer-deps --omit=dev \
    && sed -i 's/-std=c++14/-std=c++17/g; s/-std=c++1y/-std=c++17/g' node_modules/usb/binding.gyp \
    && npm_config_nodedir=/usr npm_config_build_from_source=true npm rebuild --offline
FROM registry-1.docker.io/library/alpine:3.24.0@sha256:a2d49ea686c2adfe3c992e47dc3b5e7fa6e6b5055609400dc2acaeb241c829f4
# apk 3 uses a plain absolute path for an offline file repository.
RUN sed -i 's|^file:||' /etc/apkrepos_obs_dockersupport
RUN apk add nodejs bluez-libs eudev-libs ca-certificates iputils-ping
COPY --from=builder /app /app
RUN mkdir /data && chown 65532:65532 /data
ENV HOME=/data STORAGE_PATH=/data LOG_LEVEL=info
WORKDIR /app
VOLUME ["/data"]
EXPOSE 5580
ENTRYPOINT ["node", "--enable-source-maps", "/app/node_modules/matter-server/dist/esm/MatterServer.js"]
RUN find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod a-s '{}' +
COPY --chmod=0644 hardened-malloc.so /usr/local/lib/libhardened_malloc.so
COPY --chmod=0755 allocator-check /usr/local/bin/allocator-check
COPY --chmod=0644 hardened-malloc.LICENSE /usr/share/licenses/hardened_malloc/LICENSE
ENV LD_PRELOAD=/usr/local/lib/libhardened_malloc.so
USER 65532:65532
