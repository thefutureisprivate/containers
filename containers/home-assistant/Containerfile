# Immutable upstream input; Dependabot updates the tag and digest in PRs.
FROM ghcr.io/home-assistant/home-assistant:2026.9.4@sha256:3e6710a7ab2a61311d9d899b719f6c3657791c63e8f4942cec4ebc42401d6b76
#!DisableOBSContainerSupport
USER 0:0
RUN find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod a-s '{}' +
# Run Core directly; the upstream s6 initialization assumes root.
RUN mkdir -p /config && chown 65532:65532 /config
ENV HOME=/config PYTHONMALLOC=malloc
ENTRYPOINT ["python3", "-P", "-m", "homeassistant"]
CMD ["--config", "/config"]
VOLUME ["/config"]
EXPOSE 8123
COPY --chmod=0644 hardened-malloc.so /usr/local/lib/libhardened_malloc.so
COPY --chmod=0755 allocator-check /usr/local/bin/allocator-check
COPY --chmod=0644 hardened-malloc.LICENSE /usr/share/licenses/hardened_malloc/LICENSE
ENV LD_PRELOAD=/usr/local/lib/libhardened_malloc.so
USER 65532:65532
